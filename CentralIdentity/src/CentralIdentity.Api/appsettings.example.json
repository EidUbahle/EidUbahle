{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "",
    "AccessTokenLifetimeMinutes": 10,
    "RefreshTokenLifetimeDays": 30,
    "SigningKeyId": "",
    "SigningAlgorithm": "RS256",
    "RsaPrivateKeyPemFile": ""
  },
  "OAuth": {
    "AuthorizationCodeLifetimeMinutes": 5,
