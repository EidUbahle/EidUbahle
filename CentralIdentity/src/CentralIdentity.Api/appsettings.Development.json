{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=CentralIdentityDb;Trusted_Connection=True;Encrypt=False;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Issuer": "https://identity.example.com",
    "AccessTokenLifetimeMinutes": 10,
    "RefreshTokenLifetimeDays": 30,
    "SigningKeyId": "dev-key-1",
    "SigningAlgorithm": "RS256",
    "RsaPrivateKeyPemFile": ""
  },
  "OAuth": {
    "AuthorizationCodeLifetimeMinutes": 5,
    "RequirePkce": true,
    "AllowedResponseTypes": ["code"]
  },
  "Security": {
    "ApplicationInactivityDays": 7,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "ActivityUpdateIntervalMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
