<%@ Master Language="C#" AutoEventWireup="true" CodeFile="TopNav.master.cs" Inherits="MasterPages_TopNav" %>
<!DOCTYPE html>
<html runat="server" id="htmlRoot">
<head runat="server">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#2563EB" id="metaThemeColor" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" href="/images/icons/icon-96.png" type="image/png" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/Styles/main.css" />
  <link rel="stylesheet" href="/Styles/themes.css" />
  <link rel="stylesheet" href="/Styles/components.css" />
  <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">EidUbahle ERP</asp:ContentPlaceHolder></title>
  <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body data-layout="topnav" id="appBody">
  <div id="toast-container" role="alert" aria-live="polite"></div>

  <!-- ── Top Navigation Bar ──────────────────────────────────────────────── -->
  <header class="topnav" role="banner">

    <!-- Brand -->
    <a href="/Pages/Dashboard.aspx" style="display:flex;align-items:center;gap:.625rem;text-decoration:none;color:inherit;flex-shrink:0;margin-inline-end:1.5rem;">
      <img id="tenantLogo" src="/images/logo-default.svg" alt="Logo" style="width:30px;height:30px;border-radius:8px;object-fit:contain;" />
      <span class="fw-700" id="tenantName" style="font-size:.95rem;white-space:nowrap;">EidUbahle ERP</span>
    </a>

    <!-- Primary nav links (visible on lg+) -->
    <nav class="d-none d-lg-flex align-items-center gap-1" style="flex:1;" role="navigation">
      <a href="/Pages/Dashboard.aspx" class="nav-item" style="padding:.45rem .875rem;border-radius:var(--radius-md);" data-page="dashboard">
        <span class="nav-icon"><i class="bi bi-speedometer2"></i></span>
        <span class="nav-label" data-i18n="nav.dashboard">Dashboard</span>
      </a>
      <a href="/Pages/Accounting/ChartOfAccounts.aspx" class="nav-item" style="padding:.45rem .875rem;border-radius:var(--radius-md);" data-perm="accounting.coa.view">
        <span class="nav-icon"><i class="bi bi-journal-text"></i></span>
        <span class="nav-label" data-i18n="nav.accounting">Accounting</span>
      </a>
      <a href="/Pages/Sales/Invoices.aspx" class="nav-item" style="padding:.45rem .875rem;border-radius:var(--radius-md);" data-perm="sales.invoice.view">
        <span class="nav-icon"><i class="bi bi-receipt"></i></span>
        <span class="nav-label" data-i18n="nav.sales">Sales</span>
      </a>
      <a href="/Pages/Purchases/PurchaseOrders.aspx" class="nav-item" style="padding:.45rem .875rem;border-radius:var(--radius-md);" data-perm="purchases.po.view">
        <span class="nav-icon"><i class="bi bi-cart3"></i></span>
        <span class="nav-label" data-i18n="nav.purchases">Purchases</span>
      </a>
      <a href="/Pages/Inventory/Products.aspx" class="nav-item" style="padding:.45rem .875rem;border-radius:var(--radius-md);" data-perm="inventory.product.view">
        <span class="nav-icon"><i class="bi bi-box-seam"></i></span>
        <span class="nav-label" data-i18n="nav.inventory">Inventory</span>
      </a>
      <a href="/Pages/Reports/Index.aspx" class="nav-item" style="padding:.45rem .875rem;border-radius:var(--radius-md);">
        <span class="nav-icon"><i class="bi bi-bar-chart-line"></i></span>
        <span class="nav-label" data-i18n="nav.reports">Reports</span>
      </a>
    </nav>

    <!-- Right actions -->
    <div class="d-flex align-items-center gap-2" style="flex-shrink:0;">
      <button id="syncStatusBadge" class="sync-status-bar online d-none d-sm-flex" onclick="App.showSyncPanel()">
        <span class="sync-dot"></span>
        <span id="syncStatusText">Online</span>
      </button>
      <button class="btn btn-ghost btn-icon" onclick="App.openGlobalSearch()"><i class="bi bi-search"></i></button>
      <button class="btn btn-ghost btn-icon" id="notifBtn" onclick="App.toggleNotifications()"><i class="bi bi-bell"></i><span id="notifBadge" class="badge badge-danger" style="position:absolute;top:6px;inset-inline-end:6px;font-size:.6rem;padding:2px 5px;display:none;"></span></button>
      <button class="btn btn-ghost btn-icon" onclick="App.toggleTheme()" id="themeToggleBtn"><i class="bi bi-sun" id="themeIcon"></i></button>
      <div class="dropdown">
        <button class="btn btn-ghost" style="gap:.4rem;font-size:.78rem;" onclick="App.toggleDropdown('userDropdown')">
          <div class="avatar avatar-sm" id="topbarAvatar">U</div>
          <i class="bi bi-chevron-down" style="font-size:.65rem;"></i>
        </button>
        <div class="dropdown-menu" id="userDropdown" style="inset-inline-end:0;inset-inline-start:auto;">
          <div style="padding:.75rem 1rem;border-bottom:1px solid var(--border-color);">
            <div class="fw-600" id="userMenuName" style="font-size:.85rem;"></div>
            <div class="text-muted" id="userMenuEmail" style="font-size:.75rem;"></div>
          </div>
          <a class="dropdown-item" href="/Pages/Profile.aspx"><i class="bi bi-person-circle"></i><span data-i18n="nav.profile">Profile</span></a>
          <a class="dropdown-item" href="/Admin/Settings.aspx"><i class="bi bi-gear"></i><span data-i18n="nav.settings">Settings</span></a>
          <a class="dropdown-item" href="/Admin/Translations.aspx"><i class="bi bi-translate"></i><span data-i18n="nav.translations">Translations</span></a>
          <div class="dropdown-divider"></div>
          <a class="dropdown-item text-danger" href="#" onclick="App.logout();return false;"><i class="bi bi-box-arrow-right"></i><span data-i18n="nav.logout">Sign Out</span></a>
        </div>
      </div>
      <!-- Mobile hamburger -->
      <button class="btn btn-ghost btn-icon d-lg-none" onclick="App.toggleMobileMenu()" aria-label="Menu"><i class="bi bi-list" style="font-size:1.25rem;"></i></button>
    </div>
  </header>

  <!-- Mobile dropdown menu -->
  <div id="mobileMenu" class="d-none" style="background:var(--bg-surface);border-bottom:1px solid var(--border-color);padding:.5rem 1rem;">
    <a href="/Pages/Dashboard.aspx"                 class="nav-item d-flex" style="border-radius:var(--radius-md);"><i class="bi bi-speedometer2 nav-icon"></i><span data-i18n="nav.dashboard">Dashboard</span></a>
    <a href="/Pages/Accounting/ChartOfAccounts.aspx" class="nav-item d-flex" style="border-radius:var(--radius-md);"><i class="bi bi-journal-text nav-icon"></i><span data-i18n="nav.accounting">Accounting</span></a>
    <a href="/Pages/Sales/Invoices.aspx"             class="nav-item d-flex" style="border-radius:var(--radius-md);"><i class="bi bi-receipt nav-icon"></i><span data-i18n="nav.sales">Sales</span></a>
    <a href="/Pages/Purchases/PurchaseOrders.aspx"   class="nav-item d-flex" style="border-radius:var(--radius-md);"><i class="bi bi-cart3 nav-icon"></i><span data-i18n="nav.purchases">Purchases</span></a>
    <a href="/Pages/Inventory/Products.aspx"         class="nav-item d-flex" style="border-radius:var(--radius-md);"><i class="bi bi-box-seam nav-icon"></i><span data-i18n="nav.inventory">Inventory</span></a>
    <a href="/Pages/Reports/Index.aspx"              class="nav-item d-flex" style="border-radius:var(--radius-md);"><i class="bi bi-bar-chart-line nav-icon"></i><span data-i18n="nav.reports">Reports</span></a>
  </div>

  <!-- Main -->
  <main id="pageMain" role="main" style="min-height:calc(100vh - 60px);">
    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
  </main>

  <!-- Scripts (same as Classic) -->
  <script src="https://cdn.jsdelivr.net/npm/dexie@3.2.7/dist/dexie.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc4s9bIOgUxi8T/jzmm3qAT9xnFdK6BRN6FVGnWdQqZdI" crossorigin="anonymous"></script>
  <script src="/Scripts/offline/db.js"></script>
  <script src="/Scripts/modules/i18n.js"></script>
  <script src="/Scripts/modules/theme.js"></script>
  <script src="/Scripts/sync/sync-engine.js"></script>
  <script src="/Scripts/app.js"></script>
  <asp:ContentPlaceHolder ID="ScriptContent" runat="server" />
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
    }
  </script>
</body>
</html>
