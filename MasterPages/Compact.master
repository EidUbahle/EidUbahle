<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Compact.master.cs" Inherits="MasterPages_Compact" %>
<!DOCTYPE html>
<html runat="server" id="htmlRoot">
<head runat="server">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#2563EB" id="metaThemeColor" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" href="/images/icons/icon-96.png" type="image/png" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/Styles/main.css" />
  <link rel="stylesheet" href="/Styles/themes.css" />
  <link rel="stylesheet" href="/Styles/components.css" />
  <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">EidUbahle ERP</asp:ContentPlaceHolder></title>
  <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body data-layout="compact" id="appBody">
  <div id="toast-container" role="alert" aria-live="polite"></div>

  <!-- ── Compact Header (slim, always visible) ───────────────────────────── -->
  <header class="compact-header" role="banner">
    <!-- Toggle icon-only sidebar to expanded -->
    <button id="compactSidebarToggle" class="btn btn-ghost btn-icon" onclick="App.toggleCompactSidebar()" aria-label="Expand navigation">
      <i class="bi bi-layout-sidebar" style="font-size:1.1rem;"></i>
    </button>

    <!-- Compact brand -->
    <img id="tenantLogo" src="/images/logo-default.svg" alt="Logo" style="width:26px;height:26px;border-radius:6px;object-fit:contain;" />
    <span class="fw-700 d-none d-sm-inline" id="tenantName" style="font-size:.85rem;">EidUbahle ERP</span>

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" style="flex:1;min-width:0;display:flex;align-items:center;">
      <asp:ContentPlaceHolder ID="BreadcrumbContent" runat="server" />
    </nav>

    <!-- Right controls -->
    <div class="d-flex align-items-center gap-1">
      <button id="syncStatusBadge" class="sync-status-bar online" onclick="App.showSyncPanel()" style="font-size:.68rem;">
        <span class="sync-dot"></span>
        <span id="syncStatusText" class="d-none d-sm-inline">Online</span>
      </button>
      <button class="btn btn-ghost btn-icon" onclick="App.openGlobalSearch()"><i class="bi bi-search"></i></button>
      <button class="btn btn-ghost btn-icon" onclick="App.toggleTheme()" id="themeToggleBtn"><i class="bi bi-sun" id="themeIcon"></i></button>
      <div class="dropdown">
        <button class="btn btn-ghost btn-icon" onclick="App.toggleDropdown('userDropdown')">
          <div class="avatar avatar-sm" id="topbarAvatar">U</div>
        </button>
        <div class="dropdown-menu" id="userDropdown" style="inset-inline-end:0;inset-inline-start:auto;">
          <div style="padding:.75rem 1rem;border-bottom:1px solid var(--border-color);">
            <div class="fw-600" id="userMenuName" style="font-size:.85rem;"></div>
          </div>
          <a class="dropdown-item" href="/Pages/Profile.aspx"><i class="bi bi-person-circle"></i><span data-i18n="nav.profile">Profile</span></a>
          <a class="dropdown-item" href="/Admin/Settings.aspx"><i class="bi bi-gear"></i><span data-i18n="nav.settings">Settings</span></a>
          <div class="dropdown-divider"></div>
          <a class="dropdown-item text-danger" href="#" onclick="App.logout();return false;"><i class="bi bi-box-arrow-right"></i><span data-i18n="nav.logout">Sign Out</span></a>
        </div>
      </div>
    </div>
  </header>

  <!-- Body -->
  <div style="display:flex;min-height:calc(100vh - 50px);">

    <!-- Icon-only collapsible sidebar -->
    <aside class="compact-sidebar" id="compactSidebar" role="navigation" aria-label="Main navigation">
      <nav style="padding:.5rem 0;">
        <!-- Dashboard -->
        <a href="/Pages/Dashboard.aspx" class="nav-item" style="justify-content:center;padding:.625rem;" data-page="dashboard" title="Dashboard">
          <span class="nav-icon" style="width:auto;"><i class="bi bi-speedometer2"></i></span>
          <span class="nav-label" data-i18n="nav.dashboard">Dashboard</span>
        </a>
        <a href="/Pages/Accounting/ChartOfAccounts.aspx" class="nav-item" style="justify-content:center;padding:.625rem;" title="Accounting">
          <span class="nav-icon" style="width:auto;"><i class="bi bi-journal-text"></i></span>
          <span class="nav-label" data-i18n="nav.accounting">Accounting</span>
        </a>
        <a href="/Pages/Sales/Invoices.aspx" class="nav-item" style="justify-content:center;padding:.625rem;" title="Sales">
          <span class="nav-icon" style="width:auto;"><i class="bi bi-receipt"></i></span>
          <span class="nav-label" data-i18n="nav.sales">Sales</span>
        </a>
        <a href="/Pages/Purchases/PurchaseOrders.aspx" class="nav-item" style="justify-content:center;padding:.625rem;" title="Purchases">
          <span class="nav-icon" style="width:auto;"><i class="bi bi-cart3"></i></span>
          <span class="nav-label" data-i18n="nav.purchases">Purchases</span>
        </a>
        <a href="/Pages/Inventory/Products.aspx" class="nav-item" style="justify-content:center;padding:.625rem;" title="Inventory">
          <span class="nav-icon" style="width:auto;"><i class="bi bi-box-seam"></i></span>
          <span class="nav-label" data-i18n="nav.inventory">Inventory</span>
        </a>
        <a href="/Pages/Banking/BankAccounts.aspx" class="nav-item" style="justify-content:center;padding:.625rem;" title="Banking">
          <span class="nav-icon" style="width:auto;"><i class="bi bi-bank"></i></span>
          <span class="nav-label" data-i18n="nav.banking">Banking</span>
        </a>
        <a href="/Pages/CRM/Contacts.aspx" class="nav-item" style="justify-content:center;padding:.625rem;" title="CRM">
          <span class="nav-icon" style="width:auto;"><i class="bi bi-people"></i></span>
          <span class="nav-label" data-i18n="nav.crm">CRM</span>
        </a>
        <a href="/Pages/HR/Employees.aspx" class="nav-item" style="justify-content:center;padding:.625rem;" title="HR">
          <span class="nav-icon" style="width:auto;"><i class="bi bi-person-badge"></i></span>
          <span class="nav-label" data-i18n="nav.hr">HR</span>
        </a>
        <a href="/Pages/Reports/Index.aspx" class="nav-item" style="justify-content:center;padding:.625rem;" title="Reports">
          <span class="nav-icon" style="width:auto;"><i class="bi bi-bar-chart-line"></i></span>
          <span class="nav-label" data-i18n="nav.reports">Reports</span>
        </a>
        <a href="/Admin/Settings.aspx" class="nav-item" style="justify-content:center;padding:.625rem;" title="Settings">
          <span class="nav-icon" style="width:auto;"><i class="bi bi-gear"></i></span>
          <span class="nav-label" data-i18n="nav.settings">Settings</span>
        </a>
      </nav>
    </aside>

    <!-- Page content -->
    <main id="pageMain" role="main" style="flex:1;overflow-x:hidden;" class="main-content">
      <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </main>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/dexie@3.2.7/dist/dexie.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc4s9bIOgUxi8T/jzmm3qAT9xnFdK6BRN6FVGnWdQqZdI" crossorigin="anonymous"></script>
  <script src="/Scripts/offline/db.js"></script>
  <script src="/Scripts/modules/i18n.js"></script>
  <script src="/Scripts/modules/theme.js"></script>
  <script src="/Scripts/sync/sync-engine.js"></script>
  <script src="/Scripts/app.js"></script>
  <asp:ContentPlaceHolder ID="ScriptContent" runat="server" />
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
    }
  </script>
</body>
</html>
