<%@ Page Title="Forgot Password" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="ForgotPassword.aspx.cs" Inherits="WamoApp.ForgotPasswordPage" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContentPublic" runat="server"><div class="row justify-content-center"><div class="col-lg-5"><div class="card shadow-sm"><div class="card-body p-4"><h1 class="h3 mb-3">Forgot Password</h1><form id="forgotPasswordForm" class="row g-3"><div class="col-12"><label class="form-label">Email</label><input type="email" class="form-control" name="email" required /></div><div class="col-12 d-grid"><button type="submit" class="btn btn-success">Send Reset Link</button></div></form></div></div></div></div><script>$('#forgotPasswordForm').on('submit',function(e){e.preventDefault();Wamo.ajax('/ForgotPassword.aspx/SendResetLink',{email:$('[name=email]').val()},{success:function(result){toastr.success(result.message);}});});</script></asp:Content>