<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="WamoApp.SiteMaster" %>
<!DOCTYPE html>
<html lang="<%= CurrentLanguage %>" dir="<%= IsRtl ? "rtl" : "ltr" %>">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f7a42" />
    <meta name="csrf-token" content="<%= CsrfToken %>" />
    <meta name="current-language" content="<%= CurrentLanguage %>" />
    <meta name="application-url" content="<%= ApplicationUrl %>" />
    <title><%= PageTitle %></title>
    <link rel="manifest" href="<%= ResolveUrl("~/PWA/manifest.json") %>" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/Content/css/wamo-themes.css") %>" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body class="wamo-body" data-current-user="<%= CurrentUserName %>">
    <form id="form1" runat="server">
        <nav class="navbar navbar-expand-lg navbar-dark bg-success shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" href="<%= ResolveUrl("~/Default.aspx") %>">WAMO</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" href="<%= ResolveUrl("~/Default.aspx") %>">Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="<%= ResolveUrl("~/Register.aspx") %>">Register</a></li>
                        <li class="nav-item"><a class="nav-link" href="<%= ResolveUrl("~/Request.aspx") %>">Collection Request</a></li>
                        <li class="nav-item"><a class="nav-link" href="<%= ResolveUrl("~/Shop.aspx") %>">Shop</a></li>
                        <li class="nav-item"><a class="nav-link" href="<%= ResolveUrl("~/Blog.aspx") %>">Blog</a></li>
                        <li class="nav-item"><a class="nav-link" href="<%= ResolveUrl("~/Contact.aspx") %>">Contact</a></li>
                        <% if (IsAuthenticated) { %><li class="nav-item"><a class="nav-link" href="<%= ResolveUrl("~/Account.aspx") %>">Account</a></li><% } %>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <select id="languageSwitcher" class="form-select form-select-sm w-auto"></select>
                        <select id="themeSwitcher" class="form-select form-select-sm w-auto"><option value="theme-green">WAMO Green</option><option value="theme-blue">Ocean Blue</option><option value="theme-dark">Eco Dark</option><option value="theme-light">Clean Light</option></select>
                        <% if (IsAuthenticated) { %><a class="btn btn-outline-light btn-sm" href="<%= ResolveUrl("~/Logout.aspx") %>">Logout</a><% } else { %><a class="btn btn-light btn-sm" href="<%= ResolveUrl("~/Login.aspx") %>">Login</a><% } %>
                    </div>
                </div>
            </div>
        </nav>
        <main class="container-fluid py-4">
            <% if (ShowAdminShell) { %>
            <div class="row g-4">
                <aside class="col-12 col-lg-3 col-xl-2"><div class="card shadow-sm"><div class="card-header fw-semibold">Admin Navigation</div><div class="list-group list-group-flush"><%= AdminMenuHtml %></div></div></aside>
                <section class="col-12 col-lg-9 col-xl-10"><asp:ContentPlaceHolder ID="MainContent" runat="server" /></section>
            </div>
            <% } else { %><asp:ContentPlaceHolder ID="MainContentPublic" runat="server" /><% } %>
        </main>
        <footer class="py-4 text-center border-top bg-light small text-muted"><div>WAMO Waste Management © <%= DateTime.UtcNow.Year %></div><div>Cleaner communities, safer environments.</div></footer>
    </form>
    <div id="pwaInstallPrompt" class="wamo-install-prompt d-none"><div class="card shadow-lg"><div class="card-body"><h5 class="card-title mb-2">Install WAMO App</h5><p class="card-text mb-3">Install WAMO on your device for a better experience.</p><div class="d-flex gap-2"><button id="btnInstallPwa" class="btn btn-success btn-sm">Install</button><button id="btnLaterPwa" class="btn btn-outline-secondary btn-sm">Later</button></div><div id="iosInstallHelp" class="small text-muted mt-3 d-none">Install WAMO:<br />1. Tap Share<br />2. Select Add to Home Screen<br />3. Tap Add</div></div></div></div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script><script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script><script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script><script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script><script src="<%= ResolveUrl("~/Content/js/wamo.js") %>"></script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server" />
</body>
</html>
