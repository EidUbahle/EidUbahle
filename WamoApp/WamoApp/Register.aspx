<%@ Page Title="Customer Registration" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Register.aspx.cs" Inherits="WamoApp.RegisterPage" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContentPublic" runat="server"><div class="card shadow-sm"><div class="card-body p-4"><h1 class="h3 mb-3">Register as Customer</h1><form id="registerCustomerForm" class="row g-3"><div class="col-md-6"><label class="form-label">Full Name</label><input class="form-control" name="fullName" required /></div><div class="col-md-3"><label class="form-label">Phone Number</label><input class="form-control" name="phoneNumber" required /></div><div class="col-md-3"><label class="form-label">WhatsApp Number</label><input class="form-control" name="whatsAppNumber" /></div><div class="col-md-4"><label class="form-label">Email</label><input type="email" class="form-control" name="email" /></div><div class="col-md-4"><label class="form-label">Section</label><select id="SectionID" class="form-select" name="sectionId" required></select></div><div class="col-md-2"><label class="form-label">Block</label><select id="BlockID" class="form-select" name="blockId" required></select></div><div class="col-md-2"><label class="form-label">House</label><select id="HouseID" class="form-select" name="houseId" required></select></div><div class="col-md-4"><label class="form-label">Customer Type</label><select class="form-select" name="customerType"><option>Household</option><option>Business</option><option>Hospital</option><option>Institution</option></select></div><div class="col-md-4"><label class="form-label">Waste Collection Service</label><input class="form-control" name="serviceName" value="Weekly" /></div><div class="col-md-4"><label class="form-label">Preferred Collection Schedule</label><input class="form-control" name="preferredSchedule" value="Weekly" /></div><div class="col-md-3"><label class="form-label">GPS Latitude</label><input class="form-control" name="latitude" /></div><div class="col-md-3"><label class="form-label">GPS Longitude</label><input class="form-control" name="longitude" /></div><div class="col-md-6"><label class="form-label">Address</label><input class="form-control" name="address" required /></div><div class="col-12"><label class="form-label">Notes</label><textarea class="form-control" name="notes" rows="3"></textarea></div><div class="col-12 d-grid"><button class="btn btn-success" type="submit">Submit Registration</button></div></form></div></div></asp:Content>