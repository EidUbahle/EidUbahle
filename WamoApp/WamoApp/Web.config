<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings><add name="WamoDb" connectionString="Server=.;Database=WamoDB;Trusted_Connection=True;MultipleActiveResultSets=True;" providerName="System.Data.SqlClient" /></connectionStrings>
  <appSettings>
    <add key="applicationUrl" value="https://localhost:44300" />
    <add key="DefaultLanguage" value="en" />
    <add key="CsrfHeaderName" value="X-CSRF-Token" />
    <add key="SessionCookieName" value="WAMO_SESSION" />
    <add key="AuthCookieName" value="WAMO_AUTH" />
    <add key="RequireHttps" value="false" />
    <add key="SessionInactivityMinutes" value="1440" />
    <add key="RememberMeDays" value="30" />
    <add key="ResetTokenMinutes" value="30" />
    <add key="PasswordHashIterations" value="120000" />
    <add key="MaxFailedLoginAttempts" value="5" />
    <add key="LockoutMinutes" value="15" />
    <add key="SmtpHost" value="smtp.example.com" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpUsername" value="noreply@example.com" />
    <add key="SmtpPassword" value="replace-me" />
    <add key="SmtpFromEmail" value="noreply@example.com" />
    <add key="SmtpFromName" value="WAMO" />
    <add key="EnableSsl" value="true" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" requestValidationMode="4.0" maxRequestLength="10240" executionTimeout="120" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="Predictable" validateRequest="true" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/AccessDenied.aspx" />
    <authentication mode="Forms"><forms name="WAMO_AUTH" loginUrl="~/Login.aspx" timeout="43200" slidingExpiration="true" protection="All" requireSSL="false" /></authentication>
    <authorization><deny users="?" /></authorization>
    <sessionState mode="InProc" timeout="1440" cookieSameSite="Lax" />
    <httpCookies httpOnlyCookies="true" requireSSL="false" sameSite="Lax" />
  </system.web>
  <location path="Default.aspx"><system.web><authorization><allow users="*" /></authorization></system.web></location>
  <location path="Register.aspx"><system.web><authorization><allow users="*" /></authorization></system.web></location>
  <location path="Login.aspx"><system.web><authorization><allow users="*" /></authorization></system.web></location>
  <location path="ForgotPassword.aspx"><system.web><authorization><allow users="*" /></authorization></system.web></location>
  <location path="ResetPassword.aspx"><system.web><authorization><allow users="*" /></authorization></system.web></location>
  <location path="Request.aspx"><system.web><authorization><allow users="*" /></authorization></system.web></location>
  <location path="Shop.aspx"><system.web><authorization><allow users="*" /></authorization></system.web></location>
  <location path="Blog.aspx"><system.web><authorization><allow users="*" /></authorization></system.web></location>
  <location path="Contact.aspx"><system.web><authorization><allow users="*" /></authorization></system.web></location>
  <location path="AccessDenied.aspx"><system.web><authorization><allow users="*" /></authorization></system.web></location>
  <location path="Content"><system.web><authorization><allow users="*" /></authorization></system.web></location>
  <location path="PWA"><system.web><authorization><allow users="*" /></authorization></system.web></location>
  <system.webServer>
    <defaultDocument enabled="true"><files><add value="Default.aspx" /></files></defaultDocument>
    <httpProtocol><customHeaders><add name="X-Powered-By" value="" /></customHeaders></httpProtocol>
    <staticContent><mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" /></staticContent>
  </system.webServer>
</configuration>
