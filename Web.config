<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections />

  <connectionStrings>
    <!-- Update this connection string before deployment -->
    <add name="DefaultConnection"
         connectionString="Server=YOUR_SERVER;Database=EidUbahleDB;User Id=YOUR_USER;******;MultipleActiveResultSets=True;Encrypt=True;TrustServerCertificate=False;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Application -->
    <add key="App:Name"        value="EidUbahle ERP" />
    <add key="App:Version"     value="1.0.0" />
    <add key="App:Environment" value="Development" />
    <add key="App:DefaultLanguage" value="en" />

    <!-- JWT -->
    <!-- IMPORTANT: Replace with a 64+ character random secret in production -->
    <add key="Jwt:SecretKey"            value="CHANGE-THIS-TO-A-SECURE-64-CHARACTER-RANDOM-STRING-IN-PRODUCTION!" />
    <add key="Jwt:AccessTokenMinutes"   value="15" />
    <add key="Jwt:RefreshTokenDays"     value="30" />

    <!-- Security -->
    <add key="Security:MaxLoginAttempts" value="5" />
    <add key="Security:LockoutMinutes"   value="30" />

    <!-- Storage -->
    <add key="Storage:Provider"   value="Local" />
    <add key="Storage:LocalPath"  value="~/App_Data/Uploads" />
    <!-- Azure: <add key="Storage:AzureBlobConnectionString" value="..." /> -->
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8"
                 maxRequestLength="51200"
                 executionTimeout="300"
                 enableVersionHeader="false" />

    <!-- Forms Auth is bypassed – JWT is used instead -->
    <authentication mode="None" />

    <customErrors mode="Off" />

    <globalization uiCulture="en" culture="en-US" requestEncoding="utf-8" responseEncoding="utf-8" />

    <pages clientIDMode="Static">
      <controls>
        <!-- Shared UserControls registered here -->
      </controls>
    </pages>

    <httpModules>
      <add name="JwtAuthModule" type="EidUbahle.Security.JwtAuthModule" />
    </httpModules>
  </system.web>

  <system.webServer>
    <modules>
      <add name="JwtAuthModule" type="EidUbahle.Security.JwtAuthModule" />
    </modules>

    <!-- Security headers -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options"   value="nosniff" />
        <add name="X-Frame-Options"          value="SAMEORIGIN" />
        <add name="X-XSS-Protection"         value="1; mode=block" />
        <add name="Referrer-Policy"          value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy"       value="geolocation=(), microphone=()" />
        <add name="Content-Security-Policy"
             value="default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob:; connect-src 'self';" />
      </customHeaders>
    </httpProtocol>

    <!-- Static file caching -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <!-- URL Rewrite for clean URLs and HTTPS redirect (requires URL Rewrite module) -->
    <rewrite>
      <rules>
        <rule name="Redirect HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="localhost" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>

    <validation validateIntegratedModeConfiguration="false" />
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
